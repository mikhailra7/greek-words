# Caddy in front of the backend: HTTPS (Let's Encrypt, automatic), the built SPA from /srv,
# /api and /media proxied to the backend container. DOMAIN comes from .env.
{$DOMAIN} {
	encode zstd gzip

	# Textbook upload is capped at 50 MB by the backend (MAX_UPLOAD_MB); leave room for the form.
	request_body {
		max_size 60MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Caddy replaces any X-Forwarded-For sent by the client with the real address, and the
	# backend (uvicorn --proxy-headers) takes the client IP from it for the login rate limit.
	@backend path /api/* /media/*
	handle @backend {
		reverse_proxy backend:8000
	}

	handle {
		root * /srv
		# index.html, sw.js and the manifest must be revalidated so a deploy shows up at once;
		# files in /assets have a content hash in the name and never change.
		header Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# Client-side routes (/dictionaries/3, /study …) all get the SPA.
		try_files {path} /index.html
		file_server
	}

	log {
		output stdout
		format console
	}
}
