# Copy to .env and adjust. Never commit .env.
ENV=dev
# DATABASE_URL=sqlite:////absolute/path/to/data/greek.db   (default: data/greek.db in the project)
MAX_USERS=20

# Озвучка: el-GR-AthinaNeural (женский) или el-GR-NestorasNeural (мужской)
TTS_VOICE=el-GR-AthinaNeural
TTS_RATE=-10%
# Бесплатный ключ: https://pixabay.com/api/docs/ (без ключа картинки ищутся в Openverse)
PIXABAY_API_KEY=

# Сервер (docker compose): домен сайта, на него нужна A-запись. ENV на сервере всегда prod —
# это задано в docker-compose.yml. Без домена можно временно взять <IP-с-дефисами>.sslip.io
# DOMAIN=greek.example.com
